{
	"schemaVersion": 1,
	"id": "harmony-backpack",
	"version": "${version}",
	"name": "Harmony Backpack",
	"description": "A lightweight backpack with 27 portable storage slots.",
	"authors": [
		"Vladyslav Kudriashov"
	],
	"contact": {
		"homepage": "https://github.com/hexlabelposition/harmony-backpack",
		"sources": "https://github.com/hexlabelposition/harmony-backpack"
	},
	"license": "MIT",
	"icon": "assets/harmony-backpack/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.hexlabelposition.harmony.backpack.HarmonyBackpack"
		],
		"client": [
			"dev.hexlabelposition.harmony.backpack.client.HarmonyBackpackClient"
		]
	},
	"mixins": [
		"harmony-backpack.mixins.json",
		{
			"config": "harmony-backpack.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
